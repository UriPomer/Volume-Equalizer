{
  "manifest_version": 3,
  "name": "Universal Volume Equalizer",
  "description": "在任意网页媒体元素上实时做音量均衡与自适应增益",
  "version": "0.3.1",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["limiter-worklet.js"],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}

